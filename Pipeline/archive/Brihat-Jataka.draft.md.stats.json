 "colophons": [
  [
   "s015a",
   "इति श्रीवराहमिहिरकृते बृहज्जातके राशिप्रभेदाध्यायः प्रथमः ।। 1 ।।"
  ],
  [
   "s022a",
   "इति श्रीवराहमिहिरकृते बृहज्जातके ग्रहयोनिप्रभेदाध्यायः द्वितीयः ।। 2 ।।"
  ],
  [
   "s024a",
   "इति श्रीवराहमिहिरकृते बृहज्जातके वियोनिजन्माध्यायस्तृतीयः ।। 3 ।।"
  ],
  [
   "s030a",
   "इति श्रीवराहमिहिरकृते बृहज्जातके निषेकाध्यायश्चतुर्थः ।। 4 ।।"
  ],
  [
   "s036a",
   "इति श्रीवराहमिहिरकृते बृहज्जातके जन्मकाललक्षणाध्यायः पञ्चमः ।। 5 ।।"
  ],
  [
   "s038b",
   "इति श्रीवराहमिहिरकृते बृहज्जातके बालाऽरिष्टाध्यायःषष्ठः ।। 6 ।।"
  ],
  [
   "s041b",
   "इति श्रीवराहमिहिरकृते बृहज्जातके आयुर्दायाध्यायस्सप्तमः ।। 7 ।।"
  ],
  [
   "s047b",
   "इति श्रीवराहमिहिरकृते बृहज्जातके दशान्तर्दशाध्यायोऽष्टमः ।। 8 ।।"
  ],
  [
   "s050a",
   "इति निगदितमिष्टं नेष्टमन्यद्विशेषादधिकफलविपाकं जन्मभात्तत्र दद्युः।"
  ],
  [
   "s050a",
   "इति श्रीवराहमिहिरकृते बृहज्जातकेऽष्टकवर्गाध्यायो नवमः ।। 9 ।।"
  ],
  [
   "s051a",
   "इति श्रीवराहमिहिरकृते बृहज्जातके कर्माजीवा नाम दशमोऽध्यायः ।। 10 ।।"
  ],
  [
   "s055a",
   "इति श्रीवराहमिहिरकृते बृहज्जातके राजयोगाध्यायः एकादशः ।। 11 ।।"
  ],
  [
   "s059a",
   "इति निगदिता योगाः सार्द्धं फलैरिह नाभसा।"
  ],
  [
   "s059a",
   "इति श्रीवराहमिहिरकृते बृहज्जातके नाभस् योगाध्यायः द्वादशः ।। 12 ।।"
  ],
  [
   "s061b",
   "इति श्रीवराहमिहिरकृते बृहज्जातके चन्द्राधियोगाध्यायस्त्रयोदशः ।। 13 ।।"
  ],
  [
   "s063a",
   "इति श्रीवराहमिहिरकृते बृहज्जातके द्विग्रहयोगाध्यायश्चतुर्दशः ।। 14 ।।"
  ],
  [
   "s065a",
   "इति श्रीवराहमिहिरकृते बृहज्जातके प्रव्रज्यायोगाध्यायः पञ्चदशः ।। 15 ।।"
  ],
  [
   "s067a",
   "इति श्रीवराहमिहिरकृते बृहज्जातके नक्षत्राध्यायः षोडशः ।। 16 ।।"
  ],
  [
   "s070a",
   "इति श्रीवराहमिहिरकृते बृहज्जातके चन्द्रराशिशीलाध्यायः सप्तदशः ।। 17 ।।"
  ],
  [
   "s074a",
   "इति श्रीवराहमिहिरकृते बृहज्जातके ग्रहराशिशीलाध्यायोऽष्टदशः ।। 18 ।।"
  ],
  [
   "s077b",
   "इति श्रीवराहमिहिरकृते बृहज्जातके दृष्टिफलाध्यायोऽएकोनविंशः ।। 19 ।।"
  ],
  [
   "s080a",
   "इति श्रीवराहमिहिरकृते बृहज्जातके भावाध्यायो विंशः ।। 20 ।।"
  ],
  [
   "s083a",
   "इति श्रीवसहमिहिरकृते बृहज्जातके आश्रययोगाध्यायः एकविंश ।। 121 ।।"
  ],
  [
   "s084b",
   "इति श्रीवराहमिहिरकृते बृहज्जातके प्रकीर्णाध्यायो द्वाविंशः ।। 22 ।।"
  ],
  [
   "s089b",
   "इति श्रीवराहमिहिरकृते बृहज्जातकेऽनिष्टाध्यायस्त्रयोविंशः ।। 23 ।।"
  ],
  [
   "s094b",
   "इति श्रीवराहमिहिरकृते बृहज्जातके स्त्रीजातकाध्यायः चतुर्विशः ।। 24 ।।"
  ],
  [
   "s098a",
   "इति शवपरिणामश्चिन्तनीयो यथोक्तः"
  ],
  [
   "s099a",
   "इति श्रीवराहमिहिरकृते वृहज्जातके निर्याणाध्यायः पञ्चविशः ।। 25 ।।"
  ],
  [
   "s105a",
   "इति नष्टजातकमिदं बहुप्रकारं मया विनिर्दिष्टम्।"
  ],
  [
   "s105a",
   "इति श्रीवराहमिहिरकृते बृहज्जातके नष्टजातकाध्यायः षड्विंशः ।। 26 ।।"
  ],
  [
   "s109b",
   "इति श्रीवराहमिहिरकृते बृहज्जातके द्रेष्काणाध्यायः सप्तविशः ।। 27 ।।"
  ],
  [
   "s111b",
   "इति श्रीवराहमिहिरकृते बृहज्जातके उपसंहाराध्यायोऽष्टविंशः ।। 28 ।।"
  ]
 ],
