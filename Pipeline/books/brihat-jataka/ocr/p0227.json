   "bbox": [
    430,
    1071,
    1552,
    1118
   ]
  },
  {
   "text": "O",
   "bbox": [
    367,
    1081,
    407,
    1111
   ]
  },
  {
   "text": "the oldest commentary on the Yajur VJ is accredited to",
   "bbox": [
    439,
    1120,
    1549,
    1169
   ]
  },
