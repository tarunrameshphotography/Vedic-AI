    1516,
    557
   ]
  },
  {
   "text": "order of the signs ie the lord of the first navamsa in the sign",
   "bbox": [
    303,
    553,
    1518,
    608
   ]
  },
  {
   "text": "Aries belongs to the sign Aries itself, the second belongs to",
   "bbox": [
    303,
    605,
    1517,
    661
   ]
  },
  {
   "text": "Taurus, the 3rd to Gemini (Mercury), the 4th to Cancer, the",
   "bbox": [
    303,
    657,
    1519,
    715
   ]
  },
  {
   "text": "5th to Leo, the 6th to Virgo, the 7th to Libra, the 8th to Scorpio,",
   "bbox": [
    303,
    710,
    1521,
    767
   ]
  },
  {
   "text": "the 9th to Sagittarius, the Ist Navamsa of Taurus will then",
   "bbox": [
    304,
    762,
    1518,
    820
   ]
  },
  {
   "text": "belong to Capricorn, the 2nd in the sign Taurus will belong to",
   "bbox": [
    303,
    815,
    1518,
    872
   ]
  },
  {
   "text": "Acquarius, the 3rd to Pisces, the fourth again to Aries and so",
   "bbox": [
    303,
    866,
    1519,
    927
   ]
  },
