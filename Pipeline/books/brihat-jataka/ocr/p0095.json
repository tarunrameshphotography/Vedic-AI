  {
   "text": "जीवाद्धर्मसुतायशत्रुषु दशत्र्यायारिग: शीतगो-",
   "bbox": [
    440,
    1118,
    1071,
    1177
   ]
  },
  {
   "text": "स्तेष्वेवान्त्यतप: सुतेषु च बुधाल्लग्नात्सबन्ध्वन्त्यग:।। 1 ।।",
   "bbox": [
    437,
    1177,
    1308,
    1255
   ]
  },
